#!/usr/bin/env bash
# 呼出 Sophon 交互 CLI。
# 默认启动模式就是 CLI；如需 Web，请显式传 `--web`。
# 可选：export SOPHON_JAR=/path/to/sophon-*.jar 后本脚本会 `java -jar … "$@"`。
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"
if [[ -n "${SOPHON_JAR:-}" ]]; then
  exec java -jar "$SOPHON_JAR" "$@"
fi
args_str=""
for a in "$@"; do
  args_str+=" ${a@Q}"
done
exec mvn -q exec:java -Dexec.args="$args_str"
